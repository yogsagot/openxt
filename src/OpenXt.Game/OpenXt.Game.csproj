<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Presentation layer: window, graphics device, input, and the render loop.
      It may reference the sim; the sim may never reference it.

      No MonoGame Content Builder (MGCB) here on purpose. This project is code-first with its own
      async asset loading, and the debug UI is ImGui rather than a SpriteFont, so nothing needs the
      content pipeline yet. Add MonoGame.Content.Builder.Task only when something actually does.
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>OpenXt.Game</RootNamespace>
        <AssemblyName>OpenXt</AssemblyName>
        <TieredPGO>true</TieredPGO>
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MonoGame.Framework.DesktopGL"/>
        <PackageReference Include="ImGui.NET"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenXt.Sim\OpenXt.Sim.csproj"/>
        <!--
          The converted-asset format only. NOT the importer: the game reads the cache, it never
          reaches into the player's installation or links against Assimp.
        -->
        <ProjectReference Include="..\OpenXt.Assets\OpenXt.Assets.csproj"/>
        <!-- The plugin contract, so this layer can offer IGamePlugin and read the package list. -->
        <ProjectReference Include="..\OpenXt.Modding\OpenXt.Modding.csproj"/>
    </ItemGroup>

    <!--
      Packages, not game data: this project ships no content of its own. games/ holds the game
      packages (one is selected at startup), mods/ the bundled mods and shared libraries. Both are
      copied beside the executable, which is where ModPaths looks.

      Only manifests and data are copied — a package's compiled assembly is placed by that
      package's own build, never picked up out of the source tree.
    -->
    <ItemGroup>
        <None Include="..\..\games\**\*.json" LinkBase="games" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="..\..\mods\**\*.json"
              Exclude="..\..\mods\**\bin\**;..\..\mods\**\obj\**"
              LinkBase="mods" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
