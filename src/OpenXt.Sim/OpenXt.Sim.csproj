<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Headless simulation layer. This project must NEVER reference MonoGame.
      That is the compiler-enforced version of the layering rule in CLAUDE.md:
      if a system needs a GraphicsDevice, it does not belong here.
    -->

    <PropertyGroup>
        <RootNamespace>OpenXt.Sim</RootNamespace>
        <AssemblyName>OpenXt.Sim</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DefaultEcs"/>
        <PackageReference Include="BepuPhysics"/>
    </ItemGroup>

    <ItemGroup>
        <!--
          The plugin contract and package loader. Dependency-free and graphics-free, so referencing
          it costs the headless property nothing: a sim-only mod loads in a console host.
        -->
        <ProjectReference Include="..\OpenXt.Modding\OpenXt.Modding.csproj"/>
    </ItemGroup>

</Project>
