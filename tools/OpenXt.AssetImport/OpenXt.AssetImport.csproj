<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Offline asset tooling. Assimp is a build-time tool, not a shipping dependency: the game
      loads pre-converted meshes, so neither OpenXt.Game nor OpenXt.Sim references this project.

      It writes the cache format defined in src/OpenXt.Assets, which the game reads. That library
      is the only thing the two sides share, so the format cannot drift between them.
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>OpenXt.AssetImport</RootNamespace>
        <AssemblyName>openxt-import</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AssimpNet"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenXt.XArchive\OpenXt.XArchive.csproj"/>
        <ProjectReference Include="..\..\src\OpenXt.Assets\OpenXt.Assets.csproj"/>
    </ItemGroup>

</Project>
