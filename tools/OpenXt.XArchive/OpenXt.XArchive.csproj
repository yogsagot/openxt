<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Reader for EGOSOFT's X: Beyond the Frontier / X-Tension archives.

      This project contains FORMAT LOGIC ONLY. It never carries game data, so it is safe to commit
      and safe to test in CI without anyone owning a copy of the games. It is offline tooling: the
      shipping game reads the converted cache (see src/OpenXt.Assets), never a .cat/.dat directly,
      so neither OpenXt.Game nor OpenXt.Sim references this project.

      No package dependencies on purpose — gzip comes from System.IO.Compression in the BCL.
    -->

    <PropertyGroup>
        <RootNamespace>OpenXt.XArchive</RootNamespace>
        <AssemblyName>OpenXt.XArchive</AssemblyName>
    </PropertyGroup>

</Project>
